[Unit]
Description=FinanceAcademy local readiness, disk and backup checks
After=finance-academy.service nginx.service postgresql.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/finance-academy-maintenance
TimeoutStartSec=60
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/finance-academy-maintenance
