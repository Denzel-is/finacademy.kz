{
  "name": "finance-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787 --ip 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:vps": "npm run build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "start:vps": "node build/server.mjs",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "test:flow": "node scripts/verify-flow.mjs",
    "load:prepare": "node scripts/prepare-load.mjs",
    "load:run": "node scripts/run-load.mjs",
    "load:prepare-hour": "node scripts/prepare-hour-load.mjs",
    "load:hour": "node scripts/run-hour-load.mjs",
    "load:status": "node scripts/load-status.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "git:setup": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.10.0",
    "lucide-react": "^1.31.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^6.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "undici": "7.29.1",
    "vite": "^8.3.1",
    "wrangler": "^4.140.0"
  }
}
